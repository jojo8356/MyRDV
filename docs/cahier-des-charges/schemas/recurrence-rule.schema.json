{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.myrdv.app/schemas/v1/recurrence-rule.schema.json",
  "title": "Règle de récurrence hebdomadaire MyRDV",
  "description": "Schéma normatif de la règle de récurrence d'une série de rendez-vous (F-REC-01 → F-REC-10). Sémantique : document 06. Les champs `end` et `advanced` sont optionnels ; les valeurs par défaut sont celles de l'API.",
  "type": "object",
  "additionalProperties": false,
  "required": ["freq", "byWeekday", "interval", "startDate", "startTime", "timezone", "end"],
  "properties": {
    "freq": {
      "description": "Fréquence. Seule WEEKLY est supportée en V1 (R-01). DAILY/MONTHLY réservés V2.",
      "type": "string",
      "enum": ["WEEKLY"]
    },
    "interval": {
      "description": "Nombre de semaines entre deux semaines planifiées (R-02).",
      "$ref": "#/$defs/interval"
    },
    "byWeekday": {
      "description": "Jours de la semaine sélectionnés, unique, 1 à 5 éléments (R-01). 1 = lundi … 7 = dimanche (ISO-8601).",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 7 }
    },
    "startDate": {
      "description": "Date de la première occurrence (R-05). Doit correspondre à l'un des byWeekday.",
      "type": "string",
      "format": "date"
    },
    "startTime": {
      "description": "Heure murale locale de début, résolue dans `timezone` (R-06).",
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "examples": ["09:00", "14:30"]
    },
    "durationMinutes": {
      "description": "Durée du rendez-vous (ou durationOfService si absent).",
      "type": "integer",
      "minimum": 5,
      "maximum": 480
    },
    "timezone": {
      "description": "Fuseau IANA de référence de la série (R-06, R-20).",
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "examples": ["Europe/Paris", "America/Montreal", "America/Toronto"]
    },
    "end": { "$ref": "#/$defs/end" },
    "advanced": { "$ref": "#/$defs/advanced" }
  },
  "$defs": {
    "interval": {
      "description": "Intervalle en semaines (R-02, R-10).",
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "end": {
      "description": "Condition de fin, exclusive (R-03, R-04, R-05, R-15).",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["AFTER_COUNT", "ON_DATE", "AFTER_DURATION", "NEVER"]
        },
        "count": {
          "description": "Nombre d'occurrences planifiées, requises si mode=AFTER_COUNT (R-03). Plafonné par plan.",
          "type": "integer",
          "minimum": 1,
          "maximum": 104
        },
        "until": {
          "description": "Dernière date incluse, requise si mode=ON_DATE (R-04).",
          "type": "string",
          "format": "date"
        },
        "months": {
          "description": "Durée en mois, mode=AFTER_DURATION (R-05).",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "weeks": {
          "description": "Durée en semaines, mode=AFTER_DURATION (R-05).",
          "type": "integer",
          "minimum": 1,
          "maximum": 52
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "AFTER_COUNT" } } },
          "then": { "required": ["count"], "not": { "anyOf": [{ "required": ["until"] }, { "required": ["months"] }, { "required": ["weeks"] }] } }
        },
        {
          "if": { "properties": { "mode": { "const": "ON_DATE" } } },
          "then": { "required": ["until"], "not": { "anyOf": [{ "required": ["count"] }, { "required": ["months"] }, { "required": ["weeks"] }] } }
        },
        {
          "if": { "properties": { "mode": { "const": "AFTER_DURATION" } } },
          "then": {
            "anyOf": [{ "required": ["months"] }, { "required": ["weeks"] }],
            "not": { "anyOf": [{ "required": ["count"] }, { "required": ["until"] }] }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "NEVER" } } },
          "then": { "not": { "anyOf": [{ "required": ["count"] }, { "required": ["until"] }, { "required": ["months"] }, { "required": ["weeks"] }] } }
        }
      ]
    },
    "advanced": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conflictPolicy": {
          "description": "Conduite à tenir sur conflit de disponibilité (R-09).",
          "type": "string",
          "enum": ["FAIL", "SKIP", "SHIFT_SAME_DAY"],
          "default": "SKIP"
        },
        "shiftToleranceMinutes": {
          "description": "Amplitude maximale de décalage le même jour, pas de 15 min (R-09).",
          "type": "integer",
          "minimum": 0,
          "maximum": 240,
          "multipleOf": 15,
          "default": 240
        },
        "dateShiftPolicy": {
          "description": "Conduite à tenir sur jour férié / congé (R-07).",
          "type": "string",
          "enum": ["SKIP", "SHIFT_FORWARD", "KEEP"],
          "default": "SKIP"
        },
        "rdate": {
          "description": "Dates ajoutées manuellement, hors règle (R-08).",
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "format": "date" }
        },
        "exdate": {
          "description": "Dates retirées de la série (R-08).",
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "format": "date" }
        },
        "notifyClient": {
          "description": "Envoyer le récapitulatif de série au client (F-NOT-10).",
          "type": "boolean",
          "default": true
        },
        "skipHolidays": {
          "description": "Appliquer le calendrier de jours fériés du lieu.",
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
